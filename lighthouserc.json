{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": ["http://localhost/index.html"],
      "numberOfRuns": 3,
      "settings": {
        "preset": "perf",
        "formFactor": "mobile",
        "screenEmulation": { "mobile": true, "width": 412, "height": 823, "deviceScaleFactor": 1.75, "disabled": false },
        "throttlingMethod": "simulate",
        "throttling": { "rttMs": 150, "throughputKbps": 1638.4, "cpuSlowdownMultiplier": 4 }
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": ["error", { "maxNumericValue": 2200, "aggregationMethod": "median" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05, "aggregationMethod": "median" }],
        "total-blocking-time": ["error", { "maxNumericValue": 150, "aggregationMethod": "median" }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 1300, "aggregationMethod": "median" }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 92160 }],
        "resource-summary:font:size": ["error", { "maxNumericValue": 61440 }],
        "resource-summary:document:size": ["error", { "maxNumericValue": 30720 }],
        "resource-summary:total:size": ["warn", { "maxNumericValue": 460800 }],
        "resource-summary:third-party:size": ["warn", { "maxNumericValue": 153600 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}

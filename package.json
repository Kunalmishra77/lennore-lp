                         "@tailwindcss/vite":  "^4.3.3",
                         "astro":  "^7.3.5",
                         "gsap":  "^3.15.0",
                         "lenis":  "^1.3.26",
                         "tailwindcss":  "^4.3.3",
                         "typescript":  "^5.9.3",
                         "zod":  "^4.6.5"
                     },
    "devDependencies":  {
                            "@axe-core/playwright":  "^4.13.0",
                            "@eslint/js":  "^10.0.1",
                            "@lhci/cli":  "^0.15.1",
                            "@playwright/test":  "^1.63.0",
                            "eslint":  "^10.11.0",
                            "prettier":  "^3.9.9",
                            "vitest":  "^5.0.2"
                        }
}
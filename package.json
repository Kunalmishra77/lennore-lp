{
    "name":  "lennore-lp",
    "type":  "module",
    "version":  "0.1.0",
    "private":  true,
    "engines":  {
                    "node":  "\u003e=22.12.0"
                },
    "scripts":  {
                    "dev":  "astro dev",
                    "check:content":  "node scripts/check-content.mjs",
                    "check":  "astro check",
                    "build":  "node scripts/check-content.mjs \u0026\u0026 astro check \u0026\u0026 astro build",
                    "preview":  "astro preview",
                    "format":  "prettier --write .",
                    "lint":  "eslint .",
                    "test":  "vitest run",
                    "test:e2e":  "playwright test",
                    "lhci":  "lhci autorun",
                    "lhci:local":  "lhci autorun --collect.settings.throttling.cpuSlowdownMultiplier=1"
                },
    "dependencies":  {
                         "@astrojs/check":  "^0.9.10",

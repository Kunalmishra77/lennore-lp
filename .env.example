# Copy to .env for local builds. Never commit real values. (docs/03 §18)

# --- Build-time (public, inlined into the page) ---
PUBLIC_SITE_URL=https://go.lennore.in
PUBLIC_GTM_ID=
PUBLIC_TURNSTILE_SITE_KEY=
# E.164 without "+", e.g. 91XXXXXXXXXX. Prefer setting company.whatsapp / company.phone in content/product.json.
PUBLIC_WHATSAPP_NUMBER=
PUBLIC_PHONE_NUMBER=
PUBLIC_MEDIA_BASE=
GADS_CONVERSION_ID=
GADS_LEAD_LABEL=


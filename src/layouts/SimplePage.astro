---
/** Layout for legal / utility pages: logo header, readable column, full footer. */
import { Image } from 'astro:assets';
import Base from './Base.astro';
import Footer from '../components/sections/Footer.astro';
import logo from '../assets/brand/logo-horizontal-white.png';

interface Props {
  title: string;
  description: string;
  robots?: 'index, follow' | 'noindex, follow' | 'noindex, nofollow';
  heading: string;
}
const { title, description, robots = 'index, follow', heading } = Astro.props;
---

<Base title={title} description={description} robots={robots}>
  <header slot="header" class="sp-header" data-theme="ink">
    <div class="container-page">
      <a href="/" class="sp-logo" aria-label="Lennore — home">
        <Image src={logo} alt="" width={138} height={40} loading="eager" />
      </a>
    </div>
  </header>
  <article class="sp" data-theme="ink">
    <div class="container-page sp__inner">
      <h1 class="h2">{heading}</h1>
      <div class="sp__body">
        <slot />
      </div>
    </div>
  </article>
  <Footer slot="footer" />
</Base>

<style>
  .sp-header .container-page {
    display: flex;
    align-items: center;
    height: 72px;
  }
  .sp-logo {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }
  .sp-logo :global(img) {
    height: 32px;
    width: auto;
  }
  .sp {
    padding-block: 48px 96px;
  }
  .sp__inner {
    max-width: 780px;
  }
  .sp__body {
    margin-top: 32px;
    color: var(--fg-2);
  }
  .sp__body :global(h2) {
    margin-top: 36px;
    font-size: 22px;
    line-height: 1.3;
  }
  .sp__body :global(p),
  .sp__body :global(ul) {
    margin-top: 12px;
  }
  .sp__body :global(ul) {
    padding-left: 20px;
    list-style: disc;
  }
  .sp__body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
